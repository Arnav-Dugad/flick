    <!-- How to perform each trigger -->
    <string name="d_head_tilt_up">Tip your head back a little, as if glancing at the ceiling.</string>
    <string name="d_head_tilt_down">Dip your chin towards your chest and hold briefly.</string>
    <string name="d_head_tilt_left">Lean your head towards your left shoulder.</string>
    <string name="d_head_tilt_right">Lean your head towards your right shoulder.</string>
    <string name="d_head_turn_left">Turn your head to look left.</string>
    <string name="d_head_turn_right">Turn your head to look right.</string>
    <string name="d_head_nod">A quick nod: down and straight back up.</string>
    <string name="d_face_long_blink">Close both eyes for about half a second.</string>
    <string name="d_face_double_blink">Blink twice, quickly.</string>
    <string name="d_face_mouth_open">Open your mouth wide, like saying “ah”.</string>
    <string name="d_face_smile">Give a big smile.</string>
    <string name="d_face_eyebrow_raise">Lift both eyebrows, like you\'re surprised.</string>
    <string name="d_hand_open_palm">Show your open hand to the front camera.</string>
    <string name="d_hand_fist">Make a fist in front of the camera.</string>
    <string name="d_hand_thumbs_up">Give the camera a thumbs up.</string>
    <string name="d_hand_thumbs_down">Give the camera a thumbs down.</string>
    <string name="d_hand_victory">Index and middle finger up, like a V.</string>
    <string name="d_hand_pointing_up">Hold up your index finger.</string>
    <string name="d_hand_swipe">Sweep your hand across the front camera, about 20 cm away.</string>
    <string name="d_proximity_wave">Wave a hand quickly over the top of your phone, near the front camera.</string>
    <string name="d_phone_tilt_left">Dip the left edge of your phone, then bring it back.</string>
    <string name="d_phone_tilt_right">Dip the right edge of your phone, then bring it back.</string>
    <string name="d_phone_tilt_forward">Tip the top of your phone away from you, then back.</string>
    <string name="d_phone_tilt_back">Tip the top of your phone towards you, then back.</string>
    <string name="d_phone_shake">Shake your phone firmly back and forth.</string>
    <string name="d_back_double_knock">Knock twice on the back of your phone with a fingertip.</string>
    <string name="d_back_triple_knock">Knock three times on the back of your phone.</string>
    <string name="d_volume">Press briefly. Hold it to change the volume as usual.</string>
    <string name="d_voice">Say the word clearly. Recognition happens offline on your phone.</string>

