    <string name="app_name">Flick</string>

    <!-- Accessibility service (shown in system Settings) -->
    <string name="a11y_service_label">Flick</string>
    <string name="a11y_service_description">Flick lets you control apps hands-free: a nod, a smile, a wave or a knock becomes a swipe, tap or button press.\n\nFlick uses this permission to perform gestures and system actions for you, and to know which app is open so it can use the right profile. It does not read your messages or screen content, and nothing leaves your phone.</string>

