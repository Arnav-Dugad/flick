    <!-- Onboarding -->
    <string name="onb_welcome_title">Use your phone without touching it</string>
    <string name="onb_welcome_body">Flick turns a nod, a smile, a wave or a knock into a swipe, a tap or a like, in the apps you choose.</string>
    <string name="onb_welcome_cta">Get started</string>

    <string name="onb_privacy_title">Private by design</string>
    <string name="onb_privacy_1_title">Stays on your phone</string>
    <string name="onb_privacy_1_body">Camera frames are processed in memory and never saved or sent anywhere.</string>
    <string name="onb_privacy_2_title">No accounts, ads or tracking</string>
    <string name="onb_privacy_2_body">The only network request is an optional check for Flick updates on GitHub.</string>
    <string name="onb_privacy_3_title">You\'re in control</string>
    <string name="onb_privacy_3_body">The camera only runs in apps you pick, you\'ll always see when it\'s on, and one tap stops everything.</string>
    <string name="onb_privacy_4_title">Open source</string>
    <string name="onb_privacy_4_body">Anyone can read exactly what Flick does.</string>
    <string name="onb_privacy_cta">Sounds good</string>

    <string name="onb_restricted_title">Allow restricted settings</string>
    <string name="onb_restricted_body">Android protects accessibility settings for apps installed from a file. You only need to allow this once.</string>
    <string name="onb_restricted_step1"><![CDATA[Tap <b>Open app info</b> below.]]></string>
    <string name="onb_restricted_step2"><![CDATA[Tap the <b>⋮</b> menu in the top-right corner.]]></string>
    <string name="onb_restricted_step3"><![CDATA[Tap <b>Allow restricted settings</b> and confirm with your PIN or fingerprint.]]></string>
    <string name="onb_restricted_tip">Don\'t see the option? Try turning Flick on in Accessibility first. Android sometimes shows it only after a blocked attempt.</string>
    <string name="onb_restricted_cta">Open app info</string>
    <string name="onb_restricted_done">I\'ve done this</string>

    <string name="onb_enable_title">Turn on Flick</string>
    <string name="onb_enable_body">Flick needs Android\'s accessibility permission to swipe, tap and press buttons for you, and to know which app is open so it can use the right profile.</string>
    <string name="onb_enable_never">Flick never reads your messages or screen content, and nothing leaves your phone.</string>
    <string name="onb_enable_steps"><![CDATA[In Settings, open <b>Flick</b> (it may be under <i>Installed apps</i> or <i>Downloaded apps</i>), switch it on, then tap <b>Allow</b>.]]></string>
    <string name="onb_enable_waiting">Waiting for Flick to be switched on…</string>
    <string name="onb_enable_ready">Flick is on</string>

    <string name="onb_try_title">Try your first gesture</string>
    <string name="onb_try_body">Wave your hand over the top of your phone, near the front camera, like you\'re wiping it.</string>
    <string name="onb_try_waiting">Waiting for a wave…</string>
    <string name="onb_try_success">Nice, that\'s a wave! Detected %1$d×</string>
    <string name="onb_try_footer">By default a wave goes to the next item, like the next reel. You can change this any time.</string>
    <string name="onb_try_no_sensor">Your phone doesn\'t expose a proximity sensor, so the wave trigger isn\'t available. Camera and motion gestures arrive in the next update.</string>

