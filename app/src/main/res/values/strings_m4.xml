    <!-- Auto-scroll screen -->
    <string name="as_title">Auto-scroll</string>
    <string name="as_intro">Flick scrolls the current app for you: articles, scripts, recipes. Start it with a gesture you bind to “Auto-scroll on / off”, the floating controller, or the status notification.</string>
    <string name="as_mode">Mode</string>
    <string name="as_mode_reading">Reading</string>
    <string name="as_mode_reading_body">A smooth, steady crawl.</string>
    <string name="as_mode_teleprompter">Teleprompter</string>
    <string name="as_mode_teleprompter_body">Very slow and even, for reading aloud.</string>
    <string name="as_mode_cooking">Cooking</string>
    <string name="as_mode_cooking_body">A third of a page every few seconds.</string>
    <string name="as_speed">Speed</string>
    <string name="as_face">Pause when I look away</string>
    <string name="as_face_body">Uses the front camera, only in apps that have a profile.</string>
    <string name="as_stops">Auto-scroll stops when you switch apps, lock the phone or pause Flick, and waits while you touch the screen.</string>

    <!-- Macros screen -->
    <string name="mac_title">Macros</string>
    <string name="mac_intro">Record a few taps and swipes, then run them with any gesture, for example a double knock that opens comments and goes back.</string>
    <string name="mac_record">Record a macro</string>
    <string name="mac_record_how">Flick will go to the background. Do the taps and swipes in your app, then tap Done at the top.</string>
